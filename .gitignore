# 依赖
node_modules/

# 前端构建产物（由 vite 生成，Docker 构建时重新生成）
app/backend/public/
app/frontend/dist/

# 运行时数据（归档文件、SQLite、通道状态）
archive/
data/

# 日志
*.log

# 系统文件
.DS_Store

# 构建产物（fpk 内层 app.tgz 与发布包目录）
app.tgz
dist-fpk/
# 前端热修通道产物（nas_patch_public / nas_patch_1040b 等脚本的归档点）
public-patch.tgz

# 构建工具与缓存
fnpack.exe
.dl/
app/runtime/
tmp/
# vite 构建时生成的临时配置文件（release 构建）
*.timestamp-*.mjs
